# Postgres connection string (local Postgres, Neon, Supabase, Vercel
# Postgres/Neon integration, etc). Required in every environment, including
# local dev — see README for a one-line local Postgres via Docker.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/leadflow"

AUTH_SECRET="replace-with-a-long-random-value"
NEXTAUTH_URL="http://localhost:3000"
