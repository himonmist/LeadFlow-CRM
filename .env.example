# Postgres connection string (local Postgres, Neon, Supabase, Vercel
# Postgres/Neon integration, etc). Required in every environment, including
# local dev — see README for a one-line local Postgres via Docker.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/leadflow"

AUTH_SECRET="replace-with-a-long-random-value"
NEXTAUTH_URL="http://localhost:3000"

# Secret Vercel Cron sends as `Authorization: Bearer <value>` when it calls
# /api/cron/follow-up-reminders (Vercel adds this header automatically once
# this env var exists on the project — see vercel.json). Any long random
# string. Outgoing mail itself is configured per-company in Settings, not
# here — each tenant sets its own SMTP host/user/password there.
CRON_SECRET="replace-with-a-long-random-value"
